# FasonBul - Ortam Değişkenleri Örneği
# Bu dosyayı .env olarak kopyalayıp kendi değerlerinizi girin. .env dosyası
# .gitignore'da olmalı, asla repoya commit edilmemeli.

SECRET_KEY=django-insecure-fasonbul-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Veritabanı ---
# DB_ENGINE boş/"sqlite3" bırakılırsa yerel geliştirmede SQLite kullanılır (varsayılan).
# MySQL'e geçmek için DB_ENGINE=mysql yapıp aşağıdaki alanları doldurun.
DB_ENGINE=sqlite3
DB_NAME=fasonbul
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- E-posta ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@fasonbul.com

# --- SMS (opsiyonel) ---
SMS_API_URL=
SMS_API_KEY=

# --- Cache (opsiyonel) ---
# CACHE_BACKEND=redis yapılırsa REDIS_URL kullanılır, aksi halde local-memory cache kullanılır.
CACHE_BACKEND=
REDIS_URL=redis://127.0.0.1:6379/1
